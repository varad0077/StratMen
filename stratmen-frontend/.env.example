# StratChat Firebase Web App Configuration
# Obtain these values from Firebase Console -> Project Settings -> General -> Web App

VITE_FIREBASE_API_KEY=YOUR_ACTUAL_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=stratchat-ngo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stratchat-ngo
VITE_FIREBASE_STORAGE_BUCKET=stratchat-ngo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Cloudinary 100% Free Image Upload Configuration
# Obtain from Cloudinary Dashboard (https://cloudinary.com)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=stratchat_preset_here
